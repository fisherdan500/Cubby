  contextFingerprint String?
  sourceDigest   String?
  stagedFilename String?
  stagedNonce    String?
  stagedAuthTag  String?
  stagedKeyVersion String?
  rawSourceDeletedAt DateTime?
  rawSourceRetentionReceipt Json?
  rawSourceCleanupPendingAt DateTime?
  rawSourceCleanupNextRetryAt DateTime?
  rawSourceCleanupLastError String?
  rawSourceCleanupAttempts Int @default(0)
  rawSourceCleanupLeaseToken String?
  rawSourceCleanupLeaseExpiresAt DateTime?
  status         String
  summary        Json?
  completedResult Json?
  warnings       String[]  @default([])
  error          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actorUser      User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  records        ImportedRecord[]

  @@unique([householdId, id])
  @@index([householdId])
  @@index([sourceSystem])
  @@index([createdAt])
  @@index([sourceSystem, status, rawSourceDeletedAt, createdAt])
  @@index([sourceSystem, rawSourceCleanupNextRetryAt])
}

model ImportedRecord {
  id            String      @id @default(cuid())
  householdId   String
  importBatchId String
  sourceSystem  String
  sourceTable   String
  sourceId      String
  targetType    String
  targetId      String
  checksum      String?
  createdAt     DateTime    @default(now())
  household     Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([householdId, sourceSystem, sourceTable, sourceId])
  @@index([householdId])
  @@index([importBatchId])
  @@index([targetType, targetId])
}

model Contact {
  id          String        @id @default(cuid())
  householdId String
  name        String
  kind        String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  medicines   MedicineLog[]
  calendarLinks CalendarEventContact[]

  @@index([householdId])
  @@index([deletedAt])
}

model MedicineCatalog {
  id              String    @id @default(cuid())
  householdId     String
  name            String
  typicalDoseSize Decimal?  @db.Decimal(10, 2)
  unit            String?
  doseMinTime     String?
  notes           String?
  active          Boolean   @default(true)
  isSupplement    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([name])
  @@index([isSupplement])
  @@index([deletedAt])
}

model CalendarEvent {
  id                    String    @id @default(cuid())
  householdId           String
  title                 String
  description           String?
  startTime             DateTime
  endTime               DateTime?
  allDay                Boolean   @default(false)
  eventType             String?
  location              String?
  color                 String?
  recurring             Boolean   @default(false)
  recurrencePattern     String?
  recurrenceEnd         DateTime?
  customRecurrence      String?
  reminderMinutes       Int?
  notificationSent      Boolean   @default(false)
  source                String    @default("manual")
  externalCaretakerNames String[] @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  household             Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  babies                CalendarEventBaby[]
  contacts              CalendarEventContact[]

  @@index([householdId])
  @@index([startTime])
  @@index([endTime])
  @@index([eventType])
  @@index([deletedAt])
}

model CalendarEventBaby {
  babyId  String
  eventId String
  baby    Baby          @relation(fields: [babyId], references: [id], onDelete: Cascade)
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([babyId, eventId])
  @@index([babyId])
  @@index([eventId])
}

model CalendarEventContact {
  contactId String
  eventId   String
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([contactId, eventId])
  @@index([contactId])
  @@index([eventId])
}

model VaccineDocument {
  id           String     @id @default(cuid())
  vaccineLogId String
  originalName String
  storedName   String?
  mimeType     String?
  fileSize     Int?
  sourcePath   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  vaccineLog   VaccineLog @relation(fields: [vaccineLogId], references: [id], onDelete: Cascade)

  @@index([vaccineLogId])
}

model Reminder {
  id             String       @id @default(cuid())
  householdId    String
  babyId         String
  kind           ReminderKind
  title          String
  cadenceMinutes Int?
  dueAt          DateTime?
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  household      Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  baby           Baby         @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([babyId])
  @@index([kind])
  @@index([dueAt])
  @@index([deletedAt])
}

model AuditEvent {
  id            String           @id @default(cuid())
  householdId   String
  babyId        String?
  actorUserId   String?
  actorMemberId String?
  actorUserSnapshot String?
  actorMemberSnapshot String?
  action        String
  entityType    String
  entityId      String
  schemaVersion Int              @default(1)
  correlationId String?
  chainOrder    Int
  previousHash  String?
  eventHash     String?
  before        Json?
  after         Json?
  createdAt     DateTime         @default(now())
  household     Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  baby          Baby?            @relation(fields: [householdId, babyId], references: [householdId, id], onDelete: Restrict)
  actorUser     User?            @relation(fields: [actorUserId], references: [id])
  actorMember   HouseholdMember? @relation(fields: [actorMemberId], references: [id])

  @@index([householdId])
  @@index([actorUserId])
  @@index([eventHash])
  @@unique([householdId, chainOrder])
  @@index([entityType, entityId])
  @@index([householdId, babyId, createdAt])
  @@index([createdAt])
}

model AuditIntegrityCheckpoint {
  scope      String   @id
  headHash   String
  eventCount Int
  verifiedAt DateTime
  createdAt  DateTime @default(now())

  @@index([verifiedAt])
}

model HouseholdDeletionRegistry {
  householdReferenceDigest String   @id
  auditEventCount          Int
  purgedAt                 DateTime @default(now())

  @@index([purgedAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  owner
  admin
  parent
  caretaker
  read_only
}

enum PlatformRegistrationMode {
  closed
  invitation_only
  open
}

enum InviteStatus {
  pending
  accepted
  conflicted
  revoked
  expired
}

enum InvitationOperationKind {
  PRESENTATION_CLAIM
  MANUAL_INVITE_CREATE
  MANUAL_INVITE_REPLACE
  CREDENTIAL_SETUP
  RECOVERY_ENROLLMENT
  RECOVERY_REHEARSAL
  MEMBERSHIP_ACCEPTANCE
  INVITE_REVOKE
  INVITE_REVOKE_ALL

}

enum InvitationOperationState {
  PRESENTATION_OPEN
  PRESENTATION_SUBJECT_BOUND
  PRESENTATION_CLOSED
  PREPARED
  SUBMITTED
  TERMINAL_FULL
  COMPACTED
  ABANDONED

}

enum InvitationTombstoneClass {
  FULL_COMPACTION
  RESERVATION_CLOSE

}

enum InvitationRecoveryChallengeState {
  issued
  consumed
  expired

}

enum ActivityType {
  feeding
  diaper
  sleep
  pumping
  medicine
  measurement
  milestone
  note
  bath
  play
  mood
  supplement
  vaccine
  milk_inventory
}

enum TimerState {
  none
  running
  paused
  stopped
}

enum FeedingKind {
  breast
  bottle
  formula
  solids
}

enum NursingSide {
  left
  right
  both
}

enum DiaperKind {
  wet
  dirty
  mixed
  dry
}

enum ReminderKind {
  feeding
  diaper
  medicine
  pumping
  sleep
  play
}

enum MilkInventoryAction {
  stored
  fed
  discarded
  thawed
  donated
  expired
}

enum WebhookEvent {
  activity_created
  activity_updated
  activity_deleted
  timer_started
  timer_stopped
  reminder_due
}

enum DeliveryStatus {
  pending
  delivered
  failed
}

enum NotificationPreferenceStatus {
  active
  needsReview @map("needs_review")
}

enum NotificationBabyScope {
  all
  selected
}

enum NotificationInterruptionLevel {
  passive
  normal
  timeSensitive @map("time_sensitive")
}

enum AppearanceMode {
  system
  light
  dark
}

enum AccountOperationKey {
  accountAppearanceUpdate @map("account.appearance.update")
}

enum BrowserOperationKey {
  activityCreate             @map("activity.create")
  activityUpdate             @map("activity.update")
  activityDelete             @map("activity.delete")
  activityUndoLast           @map("activity.undo_last")
  activityTimerPause         @map("activity.timer.pause")
  activityTimerResume        @map("activity.timer.resume")
  activityTimerStop          @map("activity.timer.stop")
  babyCreate                 @map("baby.create")
  babyDeactivate             @map("baby.deactivate")
  babyReactivate             @map("baby.reactivate")
  dashboardWarningDismiss    @map("dashboard.warning.dismiss")
  inviteCreate               @map("invite.create")
  inviteRevoke               @map("invite.revoke")
  inviteRevokeAll            @map("invite.revoke_all")
  memberRestore              @map("member.restore")
  memberRemove               @map("member.remove")
  memberRoleUpdate           @map("member.role.update")
  memberSuspend              @map("member.suspend")
  notificationPreferenceSave @map("notification.preference.save")
  settingsUnitsUpdate        @map("settings.units.update")
  calendarEventCreate        @map("calendar_event.create")
  householdAccentUpdate      @map("household.accent.update")
  apiKeyRevoke               @map("api_key.revoke")
}

enum BrowserOperationTargetKind {
  household
  activity
  baby
  warning
  invite
  member
  preference
  settings
  calendar
  apiKey @map("api_key")
}

enum BrowserOperationProtocolVersion {
  browserV1 @map("browser_v1")
  browserV2 @map("browser_v2")
}

enum BrowserOperationBindingState {
  open
  submitted
  revoked
  expired
  terminal
}

enum BrowserMutationOperationStatus {
  pending
  completed
  rejected
  stale
  unknown
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  appearanceMode AppearanceMode   @default(system)
  appearanceRevision Int          @default(0)
  sessions      Session[]
  accounts      Account[]
  memberships   HouseholdMember[]
  sentInvites   Invite[]          @relation("InviteSender")
  acceptedInvites Invite[]        @relation("InviteAccepter")
  auditEvents   AuditEvent[]
  pushSubscriptions PushSubscription[]
  notificationLogs NotificationLog[]
  backupRecords BackupRecord[]
  importBatches ImportBatch[]
  platformAuthority PlatformAuthority?
  platformRegistrationOperations PlatformRegistrationOperation[]
  browserOperationBindings BrowserOperationBinding[]
  browserMutationOperations BrowserMutationOperation[]
  browserMutationOperationTombstones BrowserMutationOperationTombstone[]
  accountOperationBindings AccountOperationBinding[]
  accountMutationOperations AccountMutationOperation[]
  accountMutationOperationTombstones AccountMutationOperationTombstone[]
  securityState AccountSecurityState?
  freshAuthGrants FreshAuthGrant[]
  recoveryCodeSets RecoveryCodeSet[]
  recoveryCodes RecoveryCode[]
  recoverySessions RecoverySession[]
  globalSecurityOperationBindings GlobalSecurityOperationBinding[]
  globalSecurityOperations GlobalSecurityOperation[]
  globalSecurityOperationTombstones GlobalSecurityOperationTombstone[]
  globalSecurityOperationReservationTombstones GlobalSecurityOperationReservationTombstone[]
  passwordChangeCredentialMutations PasswordChangeCredentialMutation[]
  recoveryResetCredentialMutations RecoveryResetCredentialMutation[]

  globalSecurityEvents GlobalSecurityEvent[]
  globalSecurityIncidents GlobalSecurityIncident[]
  emailChanges EmailChange[]
  sessionSecurityActivities SessionSecurityActivity[]
}

model PlatformAuthority {
  id          String            @id @default("platform")
  ownerUserId String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  settings    PlatformSettings?
  registrationOperations PlatformRegistrationOperation[]
}

model PlatformSettings {
  id                      String                   @id @default("platform")
  householdCreationMode   PlatformRegistrationMode @default(closed)
  allowPublicRegistration Boolean                  @default(false)
  revision                Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  authority               PlatformAuthority        @relation(fields: [id], references: [id], onDelete: Restrict)
}

// The one-time code that lets the first account claim platform ownership (see
// 20260919120000_platform_owner_setup_claim). Only the SHA-256 digest is stored; no application role
// can read it, and it is written only by the startup provisioner and consumed by claim_platform_setup.
model PlatformSetupCode {
  id         String   @id @default("platform")
  codeDigest String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

enum PlatformRegistrationOperationStatus {
  pending
  completed
  stale
}

model PlatformRegistrationOperation {
  id                      String                              @id @default(cuid())
  actorUserId             String
  authorityId             String                              @default("platform")
  intentFingerprint       String
  expectedRevision        Int
  householdCreationMode   PlatformRegistrationMode
  allowPublicRegistration Boolean
  status                  PlatformRegistrationOperationStatus @default(pending)
  result                  Json?
  auditEventId            String?                             @unique
  createdAt               DateTime                            @default(now())
  actor                   User                                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  authority               PlatformAuthority                   @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  auditEvent              PlatformAuditEvent?                 @relation(fields: [auditEventId], references: [id], onDelete: Restrict)

  @@index([actorUserId, id])
  @@index([createdAt])
}

model PlatformAuditEvent {
  id                    String                         @id @default(cuid())
  actorUserId           String?
  actorUserSnapshot     String?
  action                String
  entityType            String
  entityId              String
  source                String
  schemaVersion         Int                            @default(1)
  correlationId         String?
  chainOrder            Int
  previousHash          String?
  eventHash             String?
  before                Json?
  after                 Json?
  createdAt             DateTime                       @default(now())
  registrationOperation PlatformRegistrationOperation?

  @@index([actorUserId])
  @@index([eventHash])
  @@unique([chainOrder])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@unique([userId, id])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  passwordChangeCredentialMutations PasswordChangeCredentialMutation[]
  recoveryResetCredentialMutations RecoveryResetCredentialMutation[]

  @@index([userId])
}

model PasswordChangeCredentialMutation {
  userId String
  operationId String
  accountId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  operation GlobalSecurityOperation @relation(fields: [userId, operationId], references: [userId, operationId], onDelete: Cascade)
  @@id([userId, operationId])
  @@index([accountId])
}

model RecoveryResetCredentialMutation {
  userId String
  operationId String
  accountId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  operation GlobalSecurityOperation @relation(fields: [userId, operationId], references: [userId, operationId], onDelete: Cascade)
  @@id([userId, operationId])
  @@index([accountId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Household {
  id              String            @id @default(cuid())
  name            String
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  members         HouseholdMember[]
  invites         Invite[]
  babies          Baby[]
  contacts        Contact[]
  reminders       Reminder[]
  activities      ActivityLog[]
  mutationReceipts MutationReceipt[]
  auditEvents     AuditEvent[]
  settings        HouseholdSettings?
  apiKeys         ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  pushSubscriptions PushSubscription[]
  notificationPreferences NotificationPreference[]
  notificationLogs NotificationLog[]
  backupRecords   BackupRecord[]
  importBatches   ImportBatch[]
  importedRecords ImportedRecord[]
  medicineCatalog MedicineCatalog[]
  calendarEvents  CalendarEvent[]
  dashboardWarningDismissals DashboardWarningDismissal[]
  browserOperationBindings BrowserOperationBinding[]
  browserMutationOperations BrowserMutationOperation[]
  browserMutationOperationTombstones BrowserMutationOperationTombstone[]

  @@index([deletedAt])
  @@index([createdAt])
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole
  displayName String?
  joinedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  disabledAt  DateTime?
  deletedAt   DateTime?
  closureReason String?
  leaveOperationId String?  @unique
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities  ActivityLog[]
  auditEvents AuditEvent[]
  dashboardWarningDismissals DashboardWarningDismissal[]
  delegatedApiKeys ApiKey[] @relation("ApiKeyDelegatedBy")
  delegatedWebhookEndpoints WebhookEndpoint[] @relation("WebhookDelegatedBy")
  notificationPreference NotificationPreference?
  browserOperationBindings BrowserOperationBinding[]
  browserMutationOperations BrowserMutationOperation[]
  browserMutationOperationTombstones BrowserMutationOperationTombstone[]

  @@unique([householdId, id])
  @@index([householdId, role])
  @@index([userId])
  @@index([userId, disabledAt, deletedAt])
  @@index([deletedAt])
}

model Invite {
  id               String        @id @default(cuid())
  householdId      String
  email            String
  role             HouseholdRole
  tokenHash        String        @unique
  status           InviteStatus  @default(pending)
  invitedByUserId  String
  acceptedByUserId String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  household        Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy        User          @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?         @relation("InviteAccepter", fields: [acceptedByUserId], references: [id])

  @@index([householdId, status])
  @@index([email])
  @@index([expiresAt])
}

model InvitationLineage {
  id String @id @default(cuid())
  householdId String
  sourceInviteId String?
  createdAt DateTime @default(now())
  @@unique([householdId, id])
  @@index([householdId])
  @@ignore
}

model InvitationOperationIdentity {
  id String @id @db.Uuid
  operationId String @unique @db.Uuid
  householdId String
  lineageId String
  operationKind InvitationOperationKind
  state InvitationOperationState
  subjectUserId String?
  subjectRole HouseholdRole?
  createdAt DateTime @default(now())
  terminalAt DateTime?
  @@unique([id, householdId, lineageId])
  @@index([householdId, lineageId])
  @@index([state, terminalAt])
  @@ignore
}

model InvitationPresentationClaim {
  identityId String @id @db.Uuid
  householdId String
  lineageId String
  browserPartitionDigest Bytes
  tokenHashDigest Bytes
  subjectUserId String?
  expiresAt DateTime
  @@unique([identityId, householdId, lineageId])
  @@index([householdId, expiresAt])
  @@ignore
}

model InvitationOperationBinding {
  identityId String @id @db.Uuid
  householdId String
  lineageId String
  carrierKind String
  carrierDigest Bytes
  openingFingerprint Bytes
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([identityId, householdId, lineageId])
  @@ignore
}

model InvitationOperationResult {
  identityId String @id @db.Uuid
  householdId String
  lineageId String
  intentFingerprint Bytes?
  status String
  outcomeCode String?
  safeOutcome Json?
  terminalAt DateTime?
  createdAt DateTime @default(now())
  @@unique([identityId, householdId, lineageId])
  @@ignore
}

model InvitationOperationTombstone {
  identityId String @id @db.Uuid
  householdId String
  lineageId String
  class InvitationTombstoneClass
  operationKind InvitationOperationKind
  terminalCode String
  createdAt DateTime @default(now())
  @@unique([identityId, householdId, lineageId])
  @@ignore
}

model InvitationAccountSetup {
  userId String @id
  originLineageId String?
  originLineageDigest Bytes
  setupState String
  accountOrigin String
  recoverySetVersion Int?
  createdAt DateTime @default(now())
  @@index([originLineageId])
  @@ignore
}

model InvitationRecoveryEnrollmentBridge {
  identityId String @id @db.Uuid
  householdId String
  lineageId String
  subjectUserId String
  ordinarySessionId String
  globalSecurityOperationId String @unique
  verifierBatchDigest Bytes?
  intentFingerprint Bytes?
  freshAuthBoundAt DateTime?
  createdAt DateTime @default(now())

  @@unique([identityId, householdId, lineageId])
  @@index([subjectUserId, globalSecurityOperationId])
  @@ignore
}

model InvitationProcedureTransitionBinding {
  procedureName String @id
  operationKind InvitationOperationKind?
  transition String
  identityBehavior String

  @@ignore
}

enum SetupCorridorResult {
  setup_required
  ordinary
  neutral
}

model InvitationSetupCorridorAttestationReceipt {
  nonce Bytes @id
  ordinarySessionId String
  subjectUserId String
  purpose String
  keyVersion Int
  issuedAt DateTime
  macDigest Bytes
  acceptedAt DateTime @default(now())

  @@index([ordinarySessionId, acceptedAt])
  @@ignore
}

model InvitationRecoveryRehearsalChallenge {
  operationIdentityId String @id @db.Uuid
  householdId String
  lineageId String
  subjectUserId String
  ordinarySessionId String
  credentialVersion Int
  sessionSecurityVersion Int
  recoverySetVersion Int
  selectedRecoveryCodeId String
  operationId String @unique @db.Uuid
  saveAcknowledgementVersion String
  openingFingerprint Bytes
  nonce Bytes @unique
  expiresAt DateTime
  state InvitationRecoveryChallengeState @default(issued)
  consumedAt DateTime?
  attestationKeyVersion Int?
  attestationMacDigest Bytes?
  intentFingerprint Bytes?
  @@unique([operationIdentityId, householdId, lineageId])
  @@index([subjectUserId, recoverySetVersion])
  @@ignore
}

model Baby {
  id          String        @id @default(cuid())
  householdId String
  name        String
  birthDate   DateTime?
  timezone    String        @default("UTC")
  notes       String?
  feedingWarningMinutes Int?
  diaperWarningMinutes  Int?
  sleepWarningMinutes   Int?
  preferredUnits Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  inactiveAt  DateTime?
  deletedAt   DateTime?
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activities  ActivityLog[]
  reminders   Reminder[]
  notificationPreferenceSelections NotificationPreferenceBaby[]
  calendarLinks CalendarEventBaby[]
  dashboardWarningDismissals DashboardWarningDismissal[]
  auditEvents               AuditEvent[]
  browserOperationBindings BrowserOperationBinding[]
  browserMutationOperations BrowserMutationOperation[]

  @@index([householdId])
  @@unique([householdId, id])
  @@index([inactiveAt])
  @@index([deletedAt])
  @@index([createdAt])
}

model ActivityLog {
  id                String          @id @default(cuid())
  householdId       String
  babyId            String
  actorMemberId     String
  type              ActivityType
  occurredAt        DateTime
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  timezone          String
  notes             String?
  source            String          @default("manual")
  externalActorName String?
  timerState        TimerState      @default(none)
  pausedAt          DateTime?
  pausedSeconds     Int             @default(0)
  clientMutationId  String?
  clientMutationFingerprint String?
  deletedAt         DateTime?
  deletedByMemberId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  household         Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  baby              Baby            @relation(fields: [babyId], references: [id], onDelete: Cascade)
  actorMember       HouseholdMember @relation(fields: [actorMemberId], references: [id], onDelete: Restrict)
  feeding           FeedingLog?
  diaper            DiaperLog?
  sleep             SleepLog?
  pumping           PumpingLog?
  medicine          MedicineLog?
  measurement       MeasurementLog?
  milestone         MilestoneLog?
  note              NoteLog?
  bath              BathLog?
  play              PlayLog?
  mood              MoodLog?
  supplement        SupplementLog?
  vaccine           VaccineLog?
  milkInventory     MilkInventoryLog?
  webhookDeliveries WebhookDelivery[]
  notificationLogs  NotificationLog[]

  @@index([householdId])
  @@index([babyId])
  @@index([type])
  @@index([occurredAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([householdId, babyId, type, occurredAt])
  @@unique([householdId, clientMutationId])
}

model MutationReceipt {
  id                String    @id @default(cuid())
  householdId       String
  actorMemberId     String
  apiKeyId          String?
  operation         String
  targetActivityId  String
  clientMutationId  String
  intentFingerprint String
  outcomeActivityId String
  outcomeSnapshot   Json?
  createdAt         DateTime  @default(now())
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, clientMutationId])
  @@index([householdId, targetActivityId])
}

model FeedingLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  mode       FeedingKind
  amount     Decimal?    @db.Decimal(10, 2)
  unit       String?
  side       NursingSide?
  bottleType String?
  food       String?
  leftSeconds Int?
  rightSeconds Int?
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model DiaperLog {
  id          String       @id @default(cuid())
  activityId  String       @unique
  kind        DiaperKind
  color       String?
  consistency String?
  rashConcern Boolean      @default(false)
  condition   String?
  blowout     Boolean      @default(false)
  creamApplied Boolean     @default(false)
  activity    ActivityLog  @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model SleepLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  sleepType  String?
  location   String?
  quality    String?
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model PumpingLog {
  id          String       @id @default(cuid())
  activityId  String       @unique
  amount      Decimal?     @db.Decimal(10, 2)
  leftAmount  Decimal?     @db.Decimal(10, 2)
  rightAmount Decimal?     @db.Decimal(10, 2)
  unit        String?
  inventoryAction MilkInventoryAction?
  activity    ActivityLog  @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model MedicineLog {
  id          String       @id @default(cuid())
  activityId  String       @unique
  contactId   String?
  name        String
  dose        Decimal?     @db.Decimal(10, 2)
  unit        String?
  activity    ActivityLog  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id])

  @@index([contactId])
}

model SupplementLog {
  id          String       @id @default(cuid())
  activityId  String       @unique
  name        String
  dose        Decimal?     @db.Decimal(10, 2)
  unit        String?
  activity    ActivityLog  @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model MeasurementLog {
  id                String       @id @default(cuid())
  activityId        String       @unique
  weight            Decimal?     @db.Decimal(10, 2)
  weightUnit        String?
  length            Decimal?     @db.Decimal(10, 2)
  lengthUnit        String?
  headCircumference Decimal?     @db.Decimal(10, 2)
  headUnit          String?
  temperature       Decimal?     @db.Decimal(10, 2)
  temperatureUnit   String?
  measurementType   String?
  activity          ActivityLog  @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model MilestoneLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  title      String
  category   String?
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model NoteLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  category   String?
  text       String
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model BathLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  bathType   String?
  products   String?
  waterTemp  String?
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model PlayLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  activityName String?
  location   String?
  intensity  String?
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model MoodLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  mood       String
  intensity  Int?
  context    String?
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model VaccineLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  name       String
  dose       String?
  lot        String?
  provider   String?
  dueDate    DateTime?
  documentUrl String?
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
  documents  VaccineDocument[]
}

model MilkInventoryLog {
  id         String       @id @default(cuid())
  activityId String      @unique
  action     MilkInventoryAction
  amount     Decimal?    @db.Decimal(10, 2)
  unit       String?
  storage    String?
  label      String?

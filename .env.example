DATABASE_URL=postgresql://cubby:cubby_password@postgres:5432/cubby?schema=public
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000
AUTOMATED_BACKUPS_ENABLED=false
AUTOMATED_BACKUP_DIRECTORY=/var/lib/cubby/backups
CUBBY_BACKUP_HOST_DIR=./docker-data/backups
AUTOMATED_BACKUP_INTERVAL_HOURS=24
AUTOMATED_BACKUP_RETENTION_COUNT=30
AUTOMATED_BACKUP_POLL_MINUTES=15
AUTOMATED_BACKUP_RETRY_MINUTES=60
NEXT_PUBLIC_APP_NAME=Cubby
NEXT_PUBLIC_APP_TAGLINE=Track the little things.
NODE_ENV=production
TZ=UTC
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Direct LAN example (replace with the server's reserved address):
# BETTER_AUTH_URL=http://192.168.1.50:3002
# APP_PORT=3002
# TRUSTED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://192.168.1.50:3002
# Recommended live example behind local DNS and an HTTPS reverse proxy:
# BETTER_AUTH_URL=https://cubby.home.arpa
# TRUSTED_ORIGINS=https://cubby.home.arpa
EMAIL_FROM=Cubby <noreply@example.com>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ENABLE_REGISTRATION=true
ALLOW_PUBLIC_REGISTRATION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# On a fresh Linux server, `sh scripts/quick-start.sh --url https://your-address` writes a complete
# .env with every secret below freshly generated, plus the Sprout staging key file. This template lists
# every key it writes; to fill one by hand, replace each `replace-with-...` value with a new random one.
#
# The server uses the non-owner runtime role. Migrations use the separate owner role. Under Docker,
# Compose builds every connection URL from the passwords below and overrides these two, which matter
# only for local development outside Docker.
DATABASE_URL=postgresql://cubby_runtime:***@postgres:5432/cubby?schema=public
MIGRATION_DATABASE_URL=postgresql://cubby_migrator:***@postgres:5432/cubby?schema=public
# Use different generated values for each; never commit real values.
CUBBY_RUNTIME_DB_PASSWORD=replace-with-a-generated-runtime-db-password
CUBBY_MIGRATOR_DB_PASSWORD=replace-with-a-generated-migrator-db-password
CUBBY_AUTH_DB_PASSWORD=replace-with-a-generated-auth-db-password
CUBBY_EMAIL_DELIVERY_DB_PASSWORD=replace-with-a-generated-email-delivery-db-password
CUBBY_INVITATION_RUNTIME_DB_PASSWORD=replace-with-a-generated-invitation-runtime-db-password
CUBBY_INVITATION_EXPIRY_DB_PASSWORD=replace-with-a-generated-invitation-expiry-db-password
CUBBY_INVITATION_MAINTENANCE_DB_PASSWORD=replace-with-a-generated-invitation-maintenance-db-password
CUBBY_SECURITY_OPERATOR_DB_PASSWORD=replace-with-a-generated-security-operator-db-password
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# 32 random bytes, base64url without padding (43 characters).
CUBBY_THROTTLE_KEY=replace-with-a-base64url-encoded-32-byte-key
# One or two comma-separated version:base64url-32-byte keys. Keep the prior version only for the 10-minute rotation overlap.
CUBBY_FRESH_AUTH_ATTESTATION_KEYRING=1:replace-with-a-base64url-encoded-32-byte-key
CUBBY_FRESH_AUTH_ATTESTATION_ACTIVE_KEY_VERSION=1
# Separate delivery-encryption keyring. Retain old versions while nonterminal outbox rows reference them.
CUBBY_EMAIL_DELIVERY_KEYRING=1:replace-with-a-base64url-encoded-32-byte-key
CUBBY_EMAIL_DELIVERY_ACTIVE_KEY_VERSION=1
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000
APP_TIMEZONE=America/New_York
# 1 only when every request reaches Cubby through one reverse proxy that sets X-Forwarded-For.
CUBBY_TRUSTED_PROXY_HOPS=0
AUTOMATED_BACKUPS_ENABLED=false
AUTOMATED_BACKUP_DIRECTORY=/var/lib/cubby/backups
# Host directories the container writes as uid 1000; quick-start.sh creates them with that owner.
CUBBY_BACKUP_HOST_DIR=./docker-data/backups
CUBBY_SPROUT_STAGING_HOST_DIR=./docker-data/sprout-staging
# Required for encrypted Sprout preview staging: one base64-encoded 32-byte key, readable by uid 1000,
# never committed. quick-start.sh writes it here.
CUBBY_SPROUT_STAGING_KEY_FILE=./docker-data/secrets/sprout-staging.key
SPROUT_STAGING_KEY_VERSION=v1
AUTOMATED_BACKUP_INTERVAL_HOURS=24
AUTOMATED_BACKUP_RETENTION_COUNT=30
AUTOMATED_BACKUP_POLL_MINUTES=15
AUTOMATED_BACKUP_RETRY_MINUTES=60
NEXT_PUBLIC_APP_NAME=Cubby
NEXT_PUBLIC_APP_TAGLINE=Track the little things.
NODE_ENV=production
TZ=UTC
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Direct LAN example (replace with the server's reserved address):
# BETTER_AUTH_URL=http://192.168.1.50:3002
# APP_PORT=3002
# TRUSTED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://192.168.1.50:3002
# Recommended live example behind local DNS and an HTTPS reverse proxy:
# BETTER_AUTH_URL=https://cubby.home.arpa
# TRUSTED_ORIGINS=https://cubby.home.arpa
EMAIL_FROM=Cubby <noreply@example.com>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Rollback safety: old images may read ALLOW_PUBLIC_REGISTRATION; never retain it as true.
ENABLE_REGISTRATION=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

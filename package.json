{
  "name": "cubby",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Cubby - Track the little things.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run build:platform-owner && npm run build:integrity && npm run build:security-runtime-role && npm run build:invitation-runtime-roles && npm run build:household-deletion-readiness && npm run build:p13-node-builtin-probe && npm run build:fresh-auth-attestation-keys && npm run build:email-delivery-keys && npm run build:global-security-throttle-key && npm run build:platform-setup-code && npm run build:database-timezone && npm run build:security-operator && next build",
    "build:platform-owner": "esbuild scripts/platform-owner.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/platform-owner.mjs",
    "build:integrity": "esbuild scripts/integrity-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/integrity-check.mjs",
    "build:security-runtime-role": "esbuild scripts/provision-security-runtime-role.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/provision-security-runtime-role.mjs",
    "build:invitation-runtime-roles": "esbuild scripts/provision-invitation-runtime-roles.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/provision-invitation-runtime-roles.mjs",
    "build:household-deletion-readiness": "esbuild scripts/household-deletion-readiness-guard.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/household-deletion-readiness-guard.mjs",
    "build:p13-node-builtin-probe": "esbuild scripts/p1-3-node-builtin-probe.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/p1-3-node-builtin-probe.mjs",
    "build:fresh-auth-attestation-keys": "esbuild scripts/provision-fresh-auth-attestation-keys.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/provision-fresh-auth-attestation-keys.mjs",
    "build:email-delivery-keys": "esbuild scripts/provision-email-delivery-keys.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/provision-email-delivery-keys.mjs",
    "build:global-security-throttle-key": "esbuild scripts/provision-global-security-throttle-key.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/provision-global-security-throttle-key.mjs",
    "build:platform-setup-code": "esbuild scripts/provision-platform-setup-code.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/provision-platform-setup-code.mjs",
    "build:database-timezone":"esbuild scripts/provision-database-timezone.mjs --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/provision-database-timezone.mjs",
    "build:security-operator": "esbuild scripts/security-operator.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/security-operator.mjs",
    "security:operator": "tsx scripts/security-operator.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "operation-registry:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/operation-registry.ts --write",
    "operation-registry:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/operation-registry.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:backup-recovery": "tsx scripts/backup-recovery-rehearsal.ts",
    "verify:update-rehearsal": "tsx scripts/backup-recovery-rehearsal.ts",
    "verify:activity-update-safety": "tsx scripts/activity-update-safety-rehearsal.ts",
    "verify:browser-operation-pilot": "tsx scripts/browser-operation-pilot.acceptance-rehearsal.ts",
    "verify:browser-operation-save-path": "tsx scripts/browser-operation-save-path.acceptance-rehearsal.ts",
    "verify:sprout-preview-commit": "tsx scripts/sprout-preview-commit.acceptance-rehearsal.ts",
    "verify:performance-1y": "tsx scripts/performance-budgets.acceptance-rehearsal.ts --years=1",
    "verify:performance-5y": "tsx scripts/performance-budgets.acceptance-rehearsal.ts --years=5",
    "verify:performance-input": "tsx scripts/performance-budgets.acceptance-rehearsal.ts --years=1 --browser",
    "verify:update-preflight":"tsx scripts/update-preflight.ts",
    "verify:p1-3-migrator-bootstrap": "tsx scripts/p1-3-existing-volume-migrator.acceptance-rehearsal.ts",
    "verify:p1-3-invitation-acceptance": "tsx scripts/p1-3-invitation.acceptance-rehearsal.ts",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "platform:owner": "tsx scripts/platform-owner.ts",
    "verify:integrity": "tsx scripts/integrity-check.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.4.0",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/manrope": "^5.2.8",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.16.3",
    "better-auth": "^1.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.0.6",
    "prisma": "^6.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
